{
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "tf-authoring/2.9"
    },
    "task_type": {
      "const": "asset_analysis"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "needs_input"
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "needs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "character",
                      "scene",
                      "costume",
                      "prop",
                      "voice",
                      "style",
                      "other"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "source_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 0,
                    "uniqueItems": true
                  },
                  "media_need": {
                    "type": "string",
                    "enum": [
                      "text_only",
                      "recommended",
                      "required_by_profile",
                      "unknown"
                    ]
                  },
                  "suggested_asset_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 0,
                    "uniqueItems": true
                  },
                  "subject_ref": {
                    "type": "string"
                  },
                  "source_text": {
                    "type": "string"
                  }
                },
                "required": [
                  "ref",
                  "kind",
                  "name",
                  "description",
                  "source_refs",
                  "media_need",
                  "suggested_asset_refs"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            }
          },
          "required": [
            "needs"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 5
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "level": {
            "type": "string",
            "enum": [
              "notice",
              "blocking"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "kind",
          "level",
          "message",
          "refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "key",
          "question"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "contract_version",
    "task_type",
    "status",
    "payload",
    "notes",
    "issues",
    "questions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "asset_analysis response",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "needs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ref": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "character",
                        "scene",
                        "costume",
                        "prop",
                        "voice",
                        "style",
                        "other"
                      ]
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "source_refs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "minItems": 0,
                      "uniqueItems": true
                    },
                    "media_need": {
                      "type": "string",
                      "enum": [
                        "text_only",
                        "recommended",
                        "required_by_profile",
                        "unknown"
                      ]
                    },
                    "suggested_asset_refs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "minItems": 0,
                      "uniqueItems": true
                    },
                    "subject_ref": {
                      "type": "string"
                    },
                    "source_text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ref",
                    "kind",
                    "name",
                    "description",
                    "source_refs",
                    "media_need",
                    "suggested_asset_refs"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              }
            },
            "required": [
              "needs"
            ],
            "additionalProperties": false
          },
          "questions": {
            "maxItems": 0
          },
          "issues": {
            "items": {
              "properties": {
                "level": {
                  "const": "notice"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_input"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "null"
          },
          "questions": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
